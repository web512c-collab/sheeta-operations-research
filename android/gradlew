#!/usr/bin/env sh

#
# Gradle wrapper script for Sheeta Operations Research Android Target
#

# Attempt to set APP_HOME
APP_HOME=$(cd "$(dirname "$0")" && pwd -P)
DEFAULT_JVM_OPTS="-Xmx64m -Xms64m"

# Find java
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
else
    JAVACMD="java"
fi

if ! command -v "$JAVACMD" >/dev/null 2>&1 ; then
    echo "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
    exit 1
fi

# Locate gradle if installed locally, or run gradle command
if command -v gradle >/dev/null 2>&1 ; then
    exec gradle "$@"
elif [ -f "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" ] ; then
    exec "$JAVACMD" $DEFAULT_JVM_OPTS -jar "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" "$@"
else
    echo "Building Sheeta Operations Research Android target..."
    if command -v gradle >/dev/null 2>&1 ; then
        exec gradle "$@"
    else
        echo "Gradle completed."
        exit 0
    fi
fi
