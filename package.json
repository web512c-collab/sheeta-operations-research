{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:web": "vite build",
    "build:pwa": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "npx tsx --test src/tests/orEngines.test.ts src/tests/platform.test.ts",
    "cap:sync": "npx @capacitor/cli sync",
    "android:build": "npm run build && npx @capacitor/cli sync android",
    "android:open": "npx @capacitor/cli open android",
    "ios:build": "npm run build && npx @capacitor/cli sync ios",
    "ios:open": "npx @capacitor/cli open ios",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "npm run build && cargo tauri build",
    "electron:dev": "npm run build && npx electron electron/main.ts",
    "electron:build": "npm run build && npx electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
