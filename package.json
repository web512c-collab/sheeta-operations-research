{
  "name": "sheeta-operations-research",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:web": "vite build",
    "build:pwa": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "npx tsx --test src/tests/orEngines.test.ts src/tests/platform.test.ts",
    "icons:generate": "node scripts/generate-icons.js",
    "cap:sync": "npx @capacitor/cli sync",
    "android:build": "npm run build && npx @capacitor/cli sync android",
    "android:open": "npx @capacitor/cli open android",
    "ios:build": "npm run build && npx @capacitor/cli sync ios",
    "ios:open": "npx @capacitor/cli open ios",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "npm run build && cargo tauri build",
    "electron:dev": "npm run build && npx electron electron/main.ts",
    "electron:build": "npm run build && npx electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
