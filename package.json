{
  "name": "sheeta-operations-research",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/verify-dist.js",
    "build:web": "npm run build",
    "build:pwa": "npm run build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js electron/*.js",
    "lint": "tsc --noEmit",
    "test": "npx tsx --test src/tests/orEngines.test.ts src/tests/platform.test.ts src/tests/auditRegression.test.ts",
    "icons:generate": "node scripts/generate-icons.js",
    "cap:sync": "npx @capacitor/cli sync",
    "android:build": "npm run build && npx @capacitor/cli sync android",
    "android:open": "npx @capacitor/cli open android",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "npm run build && cargo tauri build",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run build && npm run electron:compile && npx electron .",
    "electron:build": "npm run build && npm run electron:compile && npx electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
